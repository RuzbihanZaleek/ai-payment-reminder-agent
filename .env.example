# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- Environment ------------------------------------------------------------
# development | testing | production. In production, WhatsApp credentials
# become required and are validated at startup.
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
ENABLE_DOCS=true

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL. Inside docker-compose the host is the `postgres` service.
# PRODUCTION: use a STRONG database password (not the demo "password") and keep
# it in a secret store, not in a committed file. In production the DB port is
# NOT published to the host (docker-compose.prod.yml) -- the app reaches
# PostgreSQL only over the private Docker network, so never expose 5432 publicly.
DATABASE_URL=postgresql://postgres:password@postgres:5432/payment_reminder
# Connection-pool tuning (server databases only).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
# The app reads whatever model id is set here (see app/core/config.py default).
# PRODUCTION: use the model the app is built around -- gpt-5.5 -- or another
# current production-grade OpenAI chat model your account has access to.
OPENAI_MODEL=gpt-5.5

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# VERIFY_TOKEN: any secret string you choose; Meta echoes it back during webhook
#   verification (GET /webhook or /webhooks/whatsapp).
# ACCESS_TOKEN / PHONE_NUMBER_ID: from the Meta app's WhatsApp > API setup.
# BUSINESS_ACCOUNT_ID (WABA id): optional; not needed to send messages.
WHATSAPP_VERIFY_TOKEN=choose-a-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0

# --- Authentication / JWT ---------------------------------------------------
# REQUIRED. Must be at least 32 characters (validated at startup).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# PRODUCTION: use a unique, high-entropy secret per environment, store it in a
# secret manager (never commit it), and rotate on suspected compromise
# (rotating invalidates all existing tokens -> users re-login).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS -------------------------------------------------------------------
# Comma-separated; "*" allows all (fine for local dev).
# PRODUCTION: never use "*" -- list your exact front-end origin(s), e.g.
#   CORS_ALLOW_ORIGINS=https://app.example.com
# and restrict methods/headers to what the client actually needs.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- Background scheduler ---------------------------------------------------
# PRODUCTION scaling: the four background jobs (reminders, notification worker,
# proactive analysis, action cleanup) are each guarded by a PostgreSQL advisory
# lock, so running multiple API replicas is safe -- only one runs each job per
# tick. To isolate background work, keep these enabled on ONE replica (or a
# dedicated worker) and set the *_ENABLED flags to false on web replicas.
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
SCHEDULER_MISFIRE_GRACE_TIME=3600
# PostgreSQL advisory-lock key so only ONE replica runs the daily job.
SCHEDULER_LOCK_ID=902025105

# --- WhatsApp delivery reliability ------------------------------------------
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_DELAY_SECONDS=2
WHATSAPP_TIMEOUT_SECONDS=10

# --- Notifications ----------------------------------------------------------
# direct = send inline during the workflow;
# outbox = record a PENDING row; the notification worker delivers it.
NOTIFICATION_MODE=direct

# Background notification worker (drains the outbox).
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_WORKER_BATCH_SIZE=50
# Advisory-lock key so only one replica's worker runs (distinct from scheduler).
NOTIFICATION_WORKER_LOCK_ID=902025106
# A message stuck PROCESSING longer than this (crashed worker) is re-queued.
NOTIFICATION_PROCESSING_TIMEOUT_MINUTES=15
# Alert when a single worker pass fails at least this many messages.
NOTIFICATION_FAILURE_ALERT_THRESHOLD=10

# --- Rate limiting (per IP, per minute) -------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_WEBHOOK_PER_MINUTE=100
