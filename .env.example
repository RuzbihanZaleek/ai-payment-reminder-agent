# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL. Inside docker-compose the host is the `postgres` service.
DATABASE_URL=postgresql://postgres:password@postgres:5432/payment_reminder

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
WHATSAPP_VERIFY_TOKEN=choose-a-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# --- Authentication / JWT ---------------------------------------------------
# REQUIRED. Must be at least 32 characters (validated at startup).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
