# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- Environment ------------------------------------------------------------
# development | testing | production. In production, WhatsApp credentials
# become required and are validated at startup.
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
ENABLE_DOCS=true

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL. Inside docker-compose the host is the `postgres` service.
DATABASE_URL=postgresql://postgres:password@postgres:5432/payment_reminder
# Connection-pool tuning (server databases only).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
WHATSAPP_VERIFY_TOKEN=choose-a-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# --- Authentication / JWT ---------------------------------------------------
# REQUIRED. Must be at least 32 characters (validated at startup).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS -------------------------------------------------------------------
# Comma-separated; "*" allows all. Lock these down in production.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- Background scheduler ---------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
SCHEDULER_MISFIRE_GRACE_TIME=3600

# --- Rate limiting (per IP, per minute) -------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_WEBHOOK_PER_MINUTE=100
